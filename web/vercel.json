{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/agency/:id",
      "destination": "/api/agency?id=:id"
    },
    {
      "source": "/og/p/:id",
      "destination": "/api/og?kind=p&id=:id"
    },
    {
      "source": "/og/agency/:id",
      "destination": "/api/og?kind=agency&id=:id"
    }
  ],
  "headers": [
    {
      "source": "/casa/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
