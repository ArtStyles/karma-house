# Local administration only. Copy to infra/.env.local; never bundle these values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PROJECT_REF=YOUR-PROJECT
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY
SUPABASE_DB_PASSWORD=YOUR-DATABASE-PASSWORD
SUPABASE_DB_HOST=YOUR-POOLER.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.YOUR-PROJECT
SUPABASE_DB_NAME=postgres
KARMAHOUSE_ADMIN_EMAIL=YOUR-VERIFIED-ADMIN-EMAIL
