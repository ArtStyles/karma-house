{
  "expo": {
    "name": "KarmaHouse",
    "slug": "karma-house",
    "version": "0.1.0",
    "scheme": "karmahouse",
    "orientation": "portrait",
    "icon": "./assets/karmahouse-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.karmahouse.app"
    },
    "android": {
      "package": "com.karmahouse.app",
      "adaptiveIcon": {
        "backgroundColor": "#132D43",
        "foregroundImage": "./assets/karmahouse-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/karmahouse-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "KarmaHouse usa las fotos que seleccionas para tu anuncio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
